[Unit]
Description=Turbo Stack panel (web UI and API)
After=network.target ts-agent.service
Wants=ts-agent.service

[Service]
Type=notify
User=turbo-stack
Group=turbo-stack
ExecStart=/opt/turbo-stack/panel/ts-panel
WorkingDirectory=/opt/turbo-stack/panel
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:7800
Restart=always
RestartSec=2

# The panel is unprivileged; everything privileged goes through ts-agent.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/turbo-stack /var/log/turbo-stack

[Install]
WantedBy=multi-user.target
