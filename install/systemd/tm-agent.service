[Unit]
Description=Turbo Manager agent (privileged operations)
After=network.target

[Service]
Type=notify
ExecStart=/opt/turbo-manager/agent/tm-agent
WorkingDirectory=/opt/turbo-manager/agent
Environment=DOTNET_ENVIRONMENT=Production
# Creates /run/turbo-manager for the agent socket.
RuntimeDirectory=turbo-manager
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
