* text=auto

# Everything that runs on the Linux server must keep LF line endings, even when checked out on Windows.
*.sh text eol=lf
*.service text eol=lf
install/** text eol=lf
test-env/** text eol=lf
scripts/** text eol=lf
# The code embeds scripts and config in C# raw strings and recipes, which keep the file's line endings.
src/** text eol=lf
*.cmd text eol=crlf
