#!/usr/bin/env bash
# Docker test environment for Turbo Manager. See docs/PLAN.md section 8.
#
#   test-env/dev package     Build release bundles into dist/ (linux-x64 by default; ARCH=arm64 to change)
#   test-env/dev up          Start a fresh Ubuntu server + the stand-in install domain
#   test-env/dev install     Run install.sh on the server, exactly like a user would (curl | bash)
#   test-env/dev e2e         Run the end-to-end checks (needs a fresh install)
#   test-env/dev all         package + reset + install + e2e (what CI runs)
#   test-env/dev recipes     Deploy the Turbo/Nitro recipes from the real GitHub repositories (slow)
#   test-env/dev hotel       A whole hotel via the wizard API from the local turbo-cloud + nitro-next (slow)
#   test-env/dev upgrade     Install release N, self-update through the panel to N+1, then a tampered and a broken release
#   test-env/dev try         package + reset + install, then open the setup page in your browser
#   test-env/dev shell       Root shell on the server
#   test-env/dev logs        Follow panel + agent logs
#   test-env/dev token       Print a new setup link
#   test-env/dev reset       Destroy and recreate the server (back to a fresh box)
#   test-env/dev down        Stop everything
#
# UBUNTU=26.04 selects the server image version (default 24.04).
# On Windows you can double-click test-env\try.cmd and test-env\stop.cmd instead.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
export UBUNTU="${UBUNTU:-24.04}"
ARCH="${ARCH:-x64}"
ARTIFACTS="$HERE/artifacts"

# MSYS_NO_PATHCONV: Git Bash on Windows would otherwise rewrite container paths like /e2e/setup-flow.sh.
compose() { (cd "$HERE" && MSYS_NO_PATHCONV=1 docker compose -f compose.yaml "$@"); }
on_server() { compose exec -T server "$@"; }

wait_for_systemd() {
    for _ in $(seq 1 60); do
        state="$(on_server systemctl is-system-running 2>/dev/null || true)"
        [[ "$state" == "running" || "$state" == "degraded" ]] && return 0
        sleep 1
    done
    echo "systemd did not finish booting in the server container" >&2
    return 1
}

cmd_package() { "$ROOT/scripts/package.sh" --arch "$ARCH"; }

cmd_up() {
    [[ -f "$ROOT/dist/install.sh" ]] || { echo "No bundle in dist/. Run: test-env/dev package" >&2; exit 1; }
    compose up -d --build install-host fake-cloudflare fake-github s3 backup-sftp server
    wait_for_systemd
    echo "Server is up (Ubuntu $UBUNTU). Setup address will be https://localhost:8443"
}

cmd_install() {
    mkdir -p "$ARTIFACTS"
    on_server bash -c "curl -fsSL http://install-host/install.sh | bash -s -- --base-url http://install-host --no-upgrade --public-host localhost" \
        | tee "$ARTIFACTS/install.log"

    # Test-only: point the panel at the fake Cloudflare and (unless REAL_GITHUB=1) fake GitHub.
    local github=""
    if [[ "${REAL_GITHUB:-0}" != 1 ]]; then
        local github_key
        github_key="$(compose exec -T fake-github awk '{print $1" "$2}' /etc/ssh/ssh_host_ed25519_key.pub | tr -d '\r')"
        github="Environment=Panel__GitHubSshHost=fake-github
Environment=Panel__GitHubHttpsBase=https://fake-github
Environment=\"Panel__GitHubKnownHosts__0=$github_key\"
Environment=Panel__DeployHealthTimeoutSeconds=20"
    fi
    on_server bash -c "mkdir -p /etc/systemd/system/tm-panel.service.d && cat > /etc/systemd/system/tm-panel.service.d/test.conf <<EOF
[Service]
Environment=Panel__CloudflareApiBase=http://fake-cloudflare:8080/client/v4
$github
EOF
systemctl daemon-reload && systemctl restart tm-panel
for _ in \$(seq 1 60); do curl -fsS http://127.0.0.1:7800/api/health >/dev/null 2>&1 && break; sleep 1; done"
}

# The setup link install.sh printed (colour codes stripped).
setup_url() {
    local url
    url="$(grep -oE 'https://[^ ]+/setup\?token=[0-9a-f]+' "$ARTIFACTS/install.log" | tail -n1 | sed 's/\x1b\[[0-9;]*m//g')"
    [[ -n "$url" ]] || { echo "No setup URL in $ARTIFACTS/install.log; run 'install' first." >&2; exit 1; }
    echo "$url"
}

cmd_e2e() {
    local url
    on_server bash -s < "$HERE/e2e/server-checks.sh"
    url="$(setup_url)"
    compose --profile test run --rm --build tester /e2e/setup-flow.sh "$url"
    on_server bash -s < "$HERE/e2e/server-post-checks.sh"
}

# Copies the committed HEAD of a local repository into the fake GitHub as <owner/name>, branch main.
mirror_local_repo() {
    local bundle="$ARTIFACTS/mirror.bundle" source
    git -C "$1" bundle create "$bundle" HEAD
    source="$(cygpath -w "$bundle" 2>/dev/null || echo "$bundle")" # docker.exe wants a Windows path
    compose cp "$source" fake-github:/tmp/mirror.bundle
    compose exec -T fake-github sh -c "rm -rf /home/git/$2.git && mkdir -p /home/git/${2%/*} \
        && git init -q --bare -b main /home/git/$2.git && git -C /home/git/$2.git fetch -q /tmp/mirror.bundle HEAD:refs/heads/main \
        && chown -R git:git /home/git/${2%/*} && rm /tmp/mirror.bundle"
}

# The Turbo and Nitro recipes against the real repositories on GitHub (slow: builds everything).
# LOCAL_NITRO=/path/to/nitro-next: the Nitro recipes against that checkout's committed HEAD instead (served by
# the fake GitHub), for verifying them before the commits are pushed.
cmd_recipes() {
    local url
    cmd_package
    cmd_reset
    if [[ -n "${LOCAL_NITRO:-}" ]]; then
        cmd_install
        mirror_local_repo "$LOCAL_NITRO" nitrodevco/nitro-next
    else
        REAL_GITHUB=1 cmd_install
    fi
    url="$(setup_url)"
    compose --profile test run --rm --build -e "LOCAL_NITRO=${LOCAL_NITRO:+1}" tester /e2e/recipes-flow.sh "$url"
}

# A whole hotel through the wizard's API, from the local turbo-cloud and nitro-next checkouts' commits
# (TURBO_CLOUD / NITRO_NEXT; default: next to this repository), served by the fake GitHub.
cmd_hotel() {
    local url turbo_cloud="${TURBO_CLOUD:-$ROOT/../turbo-workspace/turbo-cloud}" nitro_next="${NITRO_NEXT:-$ROOT/../../nitro-next}"
    [[ -d "$turbo_cloud/.git" && -d "$nitro_next/.git" ]] || { echo "Set TURBO_CLOUD and NITRO_NEXT to the local checkouts." >&2; exit 1; }
    cmd_package
    cmd_reset
    cmd_install
    mirror_local_repo "$turbo_cloud" nitrodevco/turbo-cloud
    mirror_local_repo "$nitro_next" nitrodevco/nitro-next
    url="$(setup_url)"
    compose --profile test run --rm --build tester /e2e/hotel-flow.sh "$url"
}

# Self-update: the tester keeps one session across the phases while test releases are published in between.
cmd_upgrade() {
    local url tester="tm-test-upgrade-tester"
    VERSION=0.1.0 cmd_package
    cmd_reset
    cmd_install
    url="$(setup_url)"

    docker rm -f "$tester" >/dev/null 2>&1 || true
    compose --profile test run -d --build --name "$tester" --entrypoint sleep tester infinity >/dev/null
    trap 'docker rm -f "'"$tester"'" >/dev/null 2>&1 || true' RETURN
    in_tester() { MSYS_NO_PATHCONV=1 docker exec "$tester" bash /e2e/upgrade-flow.sh "$@"; }

    in_tester prepare "$url"
    "$HERE/release.sh" 0.1.1
    in_tester update 0.1.1
    on_server bash -c '[[ "$(cat /opt/turbo-manager/VERSION)" == 0.1.1 ]] && grep -qx TM_VERSION=0.1.1 /etc/turbo-manager/install.env \
        && [[ "$(cat /var/lib/turbo-manager-updates/rollback/VERSION)" == 0.1.0 ]] && systemctl is-active --quiet tm-app-api' \
        || { echo "server: 0.1.1 installed, 0.1.0 kept for rollback, apps running — expected" >&2; return 1; }

    "$HERE/release.sh" 0.1.2 --tamper
    in_tester tampered 0.1.2

    "$HERE/release.sh" 0.1.2 --broken-panel
    in_tester broken 0.1.2
    on_server bash -c '[[ "$(cat /opt/turbo-manager/VERSION)" == 0.1.1 ]] && grep -qx TM_VERSION=0.1.1 /etc/turbo-manager/install.env \
        && systemctl is-active --quiet tm-panel tm-agent tm-app-api' \
        || { echo "server: 0.1.1 should be back and running after the rollback" >&2; return 1; }

    # Key rotation: 0.1.3 (signed with the current key) hands over a new key; 0.1.4 is signed with it; a release
    # signed with the old key is refused from then on.
    local next="$ARTIFACTS/next-release-key.pem" fingerprint
    openssl ecparam -name prime256v1 -genkey -noout -out "$next" 2>/dev/null
    openssl ec -in "$next" -pubout -out "$next.pub" 2>/dev/null
    fingerprint="$(openssl pkey -pubin -in "$next.pub" -outform DER | sha256sum | cut -c1-16)"
    "$HERE/release.sh" 0.1.3 --next-key "$next.pub"
    in_tester update 0.1.3
    on_server bash -c '[[ "$(openssl pkey -pubin -in /etc/turbo-manager/release-key.pem -outform DER | sha256sum | cut -c1-16)" == "$1" ]] \
        && [[ -f /etc/turbo-manager/release-key.previous.pem ]]' _ "$fingerprint" \
        || { echo "server: 0.1.3 should have handed over the new release key" >&2; return 1; }
    "$HERE/release.sh" 0.1.4 --sign-with "$next"
    in_tester update 0.1.4
    "$HERE/release.sh" 0.1.5
    in_tester tampered 0.1.5
    echo "Upgrade passed."
}

cmd_collect() {
    mkdir -p "$ARTIFACTS"
    on_server journalctl --no-pager -u tm-agent -u tm-panel -u nginx > "$ARTIFACTS/journal.log" 2>&1 || true
    on_server cat /etc/nginx/sites-enabled/tm-setup.conf > "$ARTIFACTS/nginx-tm-setup.conf" 2>&1 || true
    on_server ufw status verbose > "$ARTIFACTS/ufw.txt" 2>&1 || true
    echo "Collected diagnostics in $ARTIFACTS"
}

# A fresh server with the panel installed, ready to click through in a browser.
cmd_try() {
    local url
    cmd_package
    cmd_reset
    cmd_install
    url="$(setup_url)"

    printf '\nThe test server is ready. Setup link:\n\n    %s\n\n' "$url"
    printf 'Your browser will warn about the certificate: continue (this is your own test server).\n'
    printf 'In Docker Desktop it is under Containers as "tm-test": view logs, open a terminal, or stop it there.\n'
    printf 'Cloudflare here talks to a fake API: connect it with the token "test-token".\n\n'

    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*) cmd.exe //c start "" "$url" > /dev/null 2>&1 || true ;;
        Darwin) open "$url" || true ;;
        *) command -v xdg-open > /dev/null && xdg-open "$url" > /dev/null 2>&1 || true ;;
    esac
}

cmd_reset() {
    compose down --volumes --remove-orphans
    cmd_up
}

case "${1:-}" in
    package) cmd_package ;;
    up) cmd_up ;;
    install) cmd_install ;;
    e2e) cmd_e2e ;;
    upgrade) cmd_upgrade ;;
    # Separate statements (not &&) so set -e stops at the first failing step.
    all) cmd_package; cmd_reset; cmd_install; cmd_e2e ;;
    recipes) cmd_recipes ;;
    hotel) cmd_hotel ;;
    try) cmd_try ;;
    collect) cmd_collect ;;
    shell) compose exec server bash ;;
    logs) compose exec server journalctl -f -u tm-agent -u tm-panel ;;
    token) on_server tm-setup-token ;;
    reset) cmd_reset ;;
    down) compose down --volumes --remove-orphans ;;
    *) sed -n '2,21p' "$0"; exit 1 ;;
esac
