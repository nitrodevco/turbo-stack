#!/usr/bin/env bash
# Docker test environment for Turbo Manager. See docs/PLAN.md section 8.
#
#   test-env/dev package     Build release bundles into dist/ (linux-x64 by default; ARCH=arm64 to change)
#   test-env/dev up          Start a fresh Ubuntu server + the stand-in install domain
#   test-env/dev install     Run install.sh on the server, exactly like a user would (curl | bash)
#   test-env/dev e2e         Run the end-to-end checks (needs a fresh install)
#   test-env/dev all         package + reset + install + e2e (what CI runs)
#   test-env/dev try         package + reset + install, then open the setup page in your browser
#   test-env/dev shell       Root shell on the server
#   test-env/dev logs        Follow panel + agent logs
#   test-env/dev token       Print a new setup link
#   test-env/dev reset       Destroy and recreate the server (back to a fresh box)
#   test-env/dev down        Stop everything
#
# UBUNTU=26.04 selects the server image version (default 24.04).
# On Windows you can double-click test-env\try.cmd and test-env\stop.cmd instead.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
export UBUNTU="${UBUNTU:-24.04}"
ARCH="${ARCH:-x64}"
ARTIFACTS="$HERE/artifacts"

# MSYS_NO_PATHCONV: Git Bash on Windows would otherwise rewrite container paths like /e2e/setup-flow.sh.
compose() { (cd "$HERE" && MSYS_NO_PATHCONV=1 docker compose -f compose.yaml "$@"); }
on_server() { compose exec -T server "$@"; }

wait_for_systemd() {
    for _ in $(seq 1 60); do
        state="$(on_server systemctl is-system-running 2>/dev/null || true)"
        [[ "$state" == "running" || "$state" == "degraded" ]] && return 0
        sleep 1
    done
    echo "systemd did not finish booting in the server container" >&2
    return 1
}

cmd_package() { "$ROOT/scripts/package.sh" --arch "$ARCH"; }

cmd_up() {
    [[ -f "$ROOT/dist/install.sh" ]] || { echo "No bundle in dist/. Run: test-env/dev package" >&2; exit 1; }
    compose up -d --build install-host fake-cloudflare fake-github server
    wait_for_systemd
    echo "Server is up (Ubuntu $UBUNTU). Setup address will be https://localhost:8443"
}

cmd_install() {
    mkdir -p "$ARTIFACTS"
    on_server bash -c "curl -fsSL http://install-host/install.sh | bash -s -- --base-url http://install-host --no-upgrade --public-host localhost" \
        | tee "$ARTIFACTS/install.log"

    # Test-only: point the panel at the fake Cloudflare and fake GitHub instead of the real ones.
    local github_key
    github_key="$(compose exec -T fake-github awk '{print $1" "$2}' /etc/ssh/ssh_host_ed25519_key.pub | tr -d '\r')"
    on_server bash -c "mkdir -p /etc/systemd/system/tm-panel.service.d && cat > /etc/systemd/system/tm-panel.service.d/test.conf <<EOF
[Service]
Environment=Panel__CloudflareApiBase=http://fake-cloudflare:8080/client/v4
Environment=Panel__GitHubSshHost=fake-github
Environment=Panel__GitHubHttpsBase=https://fake-github
Environment=\"Panel__GitHubKnownHosts__0=$github_key\"
Environment=Panel__DeployHealthTimeoutSeconds=20
EOF
systemctl daemon-reload && systemctl restart tm-panel
for _ in \$(seq 1 60); do curl -fsS http://127.0.0.1:7800/api/health >/dev/null 2>&1 && break; sleep 1; done"
}

# The setup link install.sh printed (colour codes stripped).
setup_url() {
    local url
    url="$(grep -oE 'https://[^ ]+/setup\?token=[0-9a-f]+' "$ARTIFACTS/install.log" | tail -n1 | sed 's/\x1b\[[0-9;]*m//g')"
    [[ -n "$url" ]] || { echo "No setup URL in $ARTIFACTS/install.log; run 'install' first." >&2; exit 1; }
    echo "$url"
}

cmd_e2e() {
    local url
    on_server bash -s < "$HERE/e2e/server-checks.sh"
    url="$(setup_url)"
    compose --profile test run --rm --build tester /e2e/setup-flow.sh "$url"
    on_server bash -s < "$HERE/e2e/server-post-checks.sh"
}

cmd_collect() {
    mkdir -p "$ARTIFACTS"
    on_server journalctl --no-pager -u tm-agent -u tm-panel -u nginx > "$ARTIFACTS/journal.log" 2>&1 || true
    on_server cat /etc/nginx/sites-enabled/tm-setup.conf > "$ARTIFACTS/nginx-tm-setup.conf" 2>&1 || true
    on_server ufw status verbose > "$ARTIFACTS/ufw.txt" 2>&1 || true
    echo "Collected diagnostics in $ARTIFACTS"
}

# A fresh server with the panel installed, ready to click through in a browser.
cmd_try() {
    local url
    cmd_package
    cmd_reset
    cmd_install
    url="$(setup_url)"

    printf '\nThe test server is ready. Setup link:\n\n    %s\n\n' "$url"
    printf 'Your browser will warn about the certificate: continue (this is your own test server).\n'
    printf 'In Docker Desktop it is under Containers as "tm-test": view logs, open a terminal, or stop it there.\n'
    printf 'Cloudflare here talks to a fake API: connect it with the token "test-token".\n\n'

    case "$(uname -s)" in
        MINGW* | MSYS* | CYGWIN*) cmd.exe //c start "" "$url" > /dev/null 2>&1 || true ;;
        Darwin) open "$url" || true ;;
        *) command -v xdg-open > /dev/null && xdg-open "$url" > /dev/null 2>&1 || true ;;
    esac
}

cmd_reset() {
    compose down --volumes --remove-orphans
    cmd_up
}

case "${1:-}" in
    package) cmd_package ;;
    up) cmd_up ;;
    install) cmd_install ;;
    e2e) cmd_e2e ;;
    # Separate statements (not &&) so set -e stops at the first failing step.
    all) cmd_package; cmd_reset; cmd_install; cmd_e2e ;;
    try) cmd_try ;;
    collect) cmd_collect ;;
    shell) compose exec server bash ;;
    logs) compose exec server journalctl -f -u tm-agent -u tm-panel ;;
    token) on_server tm-setup-token ;;
    reset) cmd_reset ;;
    down) compose down --volumes --remove-orphans ;;
    *) sed -n '2,18p' "$0"; exit 1 ;;
esac
