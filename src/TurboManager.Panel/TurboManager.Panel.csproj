<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>tm-panel</AssemblyName>
    <RootNamespace>TurboManager.Panel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TurboManager.Core\TurboManager.Core.csproj" />
    <ProjectReference Include="..\TurboManager.Contracts\TurboManager.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Recipes\Manifests\*.yaml" />
    <EmbeddedResource Include="Recipes\Presets\*.yaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TurboManager.Panel.Tests" />
  </ItemGroup>

</Project>
